# Lokale Secrets für Anki Studio. Kopie als .env anlegen; .env wird nie committet.
# Start: uv run --env-file .env anki-studio serve --config studio.yaml
# Im Container stehen dieselben Einträge in /etc/anki-studio/env (Rechte 0600).

# Hash des Login-Passworts; erzeugen mit: uv run anki-studio hash-password
# Leer = noch kein Passwort; dann ist keine Anmeldung möglich.
ANKI_STUDIO_PASSWORD_HASH=

# Schlüssel für das Session-Cookie, mindestens 32 Zeichen, zum Beispiel aus:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Leer = zufälliger Schlüssel bei jedem Start; Anmeldungen enden dann mit einem Neustart.
ANKI_STUDIO_SESSION_SECRET=

# Schlüssel, mit dem Anki Studio in der Oberfläche eingegebene API-Schlüssel
# verschlüsselt (Fernet, 32 Byte URL-sicheres Base64), zum Beispiel aus:
# python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# Leer = API-Schlüssel lassen sich in der Oberfläche nicht speichern.
ANKI_STUDIO_SECRET_KEY=

# Zugangsdaten des Anki-Sync-Servers. Der Endpunkt steht getrennt davon in
# studio.yaml als sync_endpoint. Beide Werte bleiben in der Umgebung und
# werden nie in Jobs, Statusdateien oder der Oberfläche gespeichert.
ANKI_STUDIO_SYNC_USERNAME=
ANKI_STUDIO_SYNC_PASSWORD=
